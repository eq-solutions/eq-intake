{
  "name": "eq-platform",
  "version": "0.0.1",
  "private": true,
  "description": "EQ — AI-shaped bridge between trade systems (parse / validate / reshape). Packages monorepo; shell UI lives in eq-shell.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome lint packages --diagnostic-level=error",
    "lint:fix": "biome check packages --write --diagnostic-level=error",
    "check": "pnpm schemas:lint && pnpm -r --if-present typecheck",
    "check:packages": "pnpm schemas:lint && pnpm -r --filter \"./packages/*\" --filter \"!./packages/eq-format-ui\" --filter \"!./packages/eq-intake-demo\" build && pnpm -r --filter \"./packages/*\" --filter \"!./packages/eq-format-ui\" --filter \"!./packages/eq-intake-demo\" --if-present typecheck",
    "schemas:lint": "pnpm --filter @eq/schemas schemas:lint",
    "generate": "pnpm --filter @eq/schemas generate",
    "generate:sql": "pnpm --filter @eq/schemas generate:sql",
    "db:apply": "pnpm generate:sql && tsx scripts/db-apply.ts",
    "ci:drift": "pnpm --filter @eq/schemas generate && git diff --exit-code",
    "test:integration": "pnpm --filter @eq/ai test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=6.4.3 <7.0.0",
      "ajv": ">=8.18.0 <9.0.0",
      "fast-uri": ">=3.1.4 <4.0.0",
      "uuid": ">=11.1.1 <12.0.0",
      "js-yaml": ">=4.3.0 <5.0.0",
      "postcss": ">=8.5.18 <9.0.0",
      "@babel/core": ">=7.29.6 <8.0.0",
      "undici": ">=7.28.0 <8.0.0",
      "esbuild": ">=0.25.0 <0.26.0",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "tar": ">=7.5.21 <8.0.0",
      "nanoid": ">=3.3.18 <4.0.0",
      "browserslist": ">=4.28.7 <5.0.0"
    }
  }
}
