{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "**/node_modules/**",
      "**/dist/**",
      "**/.generated/**",
      "**/src/generated/**",
      "**/coverage/**",
      "**/*.min.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useNumberNamespace": "off",
        "noUnusedTemplateLiteral": "off",
        "useImportType": "off",
        "noInferrableTypes": "off",
        "useConst": "warn",
        "useSingleVarDeclarator": "off",
        "useExponentiationOperator": "off"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noForEach": "off",
        "noBannedTypes": "off",
        "useOptionalChain": "warn",
        "useRegexLiterals": "warn"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "noGlobalIsNan": "warn",
        "noGlobalIsFinite": "warn",
        "noShadowRestrictedNames": "warn"
      },
      "a11y": {
        "useSemanticElements": "off",
        "noAutofocus": "off",
        "useKeyWithClickEvents": "off",
        "useButtonType": "warn"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      },
      "performance": {
        "noDelete": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  }
}
