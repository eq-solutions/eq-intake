{
  "name": "@eq/format-ui",
  "version": "0.0.1",
  "private": true,
  "description": "EQ Format — drop a messy CSV; AI learns its shape, validates against EQ, shows what would land. Local Vite demo + API middleware (@eq/ai + @eq/validation). Demo-grade only.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@eq-solutions/tokens": "github:eq-solutions/eq-design-tokens#v1.3.2",
    "@eq/schemas": "workspace:*",
    "@eq/validation": "workspace:*",
    "@eq/ai": "workspace:*",
    "@fontsource/plus-jakarta-sans": "^5.2.8"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "typescript": "5.6.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
