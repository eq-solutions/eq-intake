# Copy to eq-platform/.env (gitignored) and fill in what you need.
# AI learns each system's shape so humans don't retype between them —
# keys below power that mapping locally. Never commit real values.

# ── Local AI (Format UI server + package integration tests) ───────────────
# Required for: pnpm --filter @eq/format-ui dev, pnpm test:integration
ANTHROPIC_API_KEY=

# ── Intake demo (Vite — values are inlined into the browser bundle) ───────
# Demo / localhost only. Prefer a local proxy for real calls (CORS).
# See packages/eq-intake-demo/README.md
# VITE_ANTHROPIC_API_KEY=
# VITE_ANTHROPIC_BASE_URL=http://localhost:3001/anthropic/v1

# ── Tenant plane (edge functions, smoke, seed, RLS scripts) ───────────────
# Live SKS/EQ planes: SELECT only without explicit approval (see README).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
# Host-injected on Edge: SUPABASE_SERVICE_ROLE_KEY
# Local scripts often use this alias instead:
# SUPABASE_SERVICE_KEY=

# ── Optional script / smoke harnesses ─────────────────────────────────────
# TEST_TENANT_ID=
# SMOKE_VERBOSE=1
# TENANT_A_JWT=
# TENANT_B_JWT=
# EQ_SERVICE_TOKEN=

# Cards ↔ employer bridge (approve-worker-assignment / migrate scripts)
# CARDS_SUPABASE_URL=
# CARDS_SERVICE_ROLE_KEY=
# CARDS_SUPABASE_KEY=
# TARGET_SUPABASE_URL=
# TARGET_SUPABASE_KEY=
# TARGET_TENANT_ID=

# Shell host (eq-shell repo, not this monorepo) commonly also uses:
# VITE_SUPABASE_URL=  VITE_SUPABASE_ANON_KEY=  VITE_TENANT_ID=
# VITE_TENANT=  VITE_ENABLED_MODULES=
